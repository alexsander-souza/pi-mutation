{
  "name": "pi-mutation",
  "version": "0.1.0",
  "description": "LLM-guided mutation testing plugin for Oh My Pi",
  "keywords": [
    "oh-my-pi",
    "omp",
    "omp-plugin",
    "mutation-testing",
    "llm",
    "testing",
    "pytest",
    "go-test"
  ],
  "homepage": "https://github.com/alexsander-souza/pi-mutation#readme",
  "bugs": {
    "url": "https://github.com/alexsander-souza/pi-mutation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexsander-souza/pi-mutation.git"
  },
  "license": "MIT",
  "author": "Alexsander Silva de Souza <alexsander.desouza@gmail.com>",
  "type": "module",
  "files": [
    "src",
    "!src/__tests__",
    "skills"
  ],
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test src/__tests__/",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test src/__tests__/integration.test.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.5.0"
  }
}
